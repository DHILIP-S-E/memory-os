# Copy to backend/.env and fill in. Never commit the real .env.
# Every service below is optional: left blank, its feature says "not configured" instead of failing.

# Postgres (for example Neon). The app adds the right driver itself.
DATABASE_URL=postgresql://user:password@host:5432/personal_memory_os?sslmode=require

# Sign-in. A long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Google sign-in: your OAuth client IDs (web, Android, iOS), comma-separated
GOOGLE_CLIENT_IDS=
# Browser origins allowed to call the API, comma-separated (the web dashboard's address)
CORS_ORIGINS=http://localhost:5173

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.8-flash
GEMINI_MODEL_STRONG=gemini-4-argon
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Cloudflare R2: an API token with Object Read & Write on the bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=personal-memory-os
# R2_ENDPOINT=http://localhost:9000   # only to use a local S3-compatible store instead

# Firebase Cloud Messaging (push to phones): the project id and the path to a service-account key file
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=

# Local development only: accept any token. Never in production.
ALLOW_INSECURE_DEV_AUTH=false
